# Copy this file to .env and fill in your values

# Claude (Anthropic) API Configuration - for chat
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI API Configuration - for embeddings
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# User credentials for login (format: username1:password1:role,username2:password2:role)
# Roles: admin, user (default if not specified)
# Example: admin:secretpassword:admin,hr_user:hrpass:user,manager:manager456:user
APP_USERS=admin:admin123:admin,hr_user:hrpass:user